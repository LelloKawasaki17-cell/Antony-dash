
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Antony Dash</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  overflow: hidden;
  background: #080914;
  color: white;
  font-family: Arial, Helvetica, sans-serif;
  touch-action: none;
}

#game {
  position: fixed;
  inset: 0;
}

canvas {
  display: block;
}

#loading {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: #080914;
  text-align: center;
  padding: 25px;
}

#loading h1 {
  font-size: 38px;
  color: #ffb52e;
  text-shadow: 0 0 25px #ff7800;
}

#loading p {
  margin-top: 15px;
  color: #aaa;
}

#loading.error {
  color: #ff6464;
}

#hud {
  position: fixed;
  inset: 0;
  pointer-events: none;
  display: none;
}

.topbar {
  display: flex;
  justify-content: space-between;
  padding: 18px;
  gap: 10px;
}

.stat {
  background: rgba(8, 10, 25, 0.75);
  border: 1px solid rgba(255, 180, 50, 0.5);
  border-radius: 15px;
  padding: 10px 15px;
  backdrop-filter: blur(10px);
  box-shadow: 0 0 18px rgba(255, 150, 0, 0.12);
}

.stat small {
  display: block;
  color: #aaa;
  font-size: 10px;
  letter-spacing: 2px;
}

.stat strong {
  display: block;
  margin-top: 4px;
  font-size: 22px;
  color: #ffc34d;
}

#fatherMessage {
  position: fixed;
  top: 22%;
  left: 50%;
  transform: translateX(-50%) scale(0.8);
  opacity: 0;
  z-index: 10;
  pointer-events: none;
  background: #b60018;
  border: 3px solid #ffb52e;
  color: white;
  font-weight: 1000;
  font-size: clamp(24px, 6vw, 45px);
  padding: 18px 25px;
  border-radius: 20px;
  text-align: center;
  text-shadow: 3px 3px #600;
  box-shadow: 0 0 40px #ff0000;
  transition: 0.3s;
}

#fatherMessage.show {
  opacity: 1;
  transform: translateX(-50%) scale(1);
}

#controls {
  position: fixed;
  bottom: 20px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  padding: 0 20px;
  pointer-events: none;
}

.controlGroup {
  display: flex;
  gap: 10px;
}

.control {
  pointer-events: auto;
  width: 62px;
  height: 62px;
  border-radius: 18px;
  border: 2px solid rgba(255, 190, 70, 0.8);
  background: rgba(10, 12, 28, 0.75);
  color: white;
  font-size: 26px;
  font-weight: bold;
  box-shadow: 0 0 20px rgba(255, 160, 0, 0.2);
  backdrop-filter: blur(8px);
  user-select: none;
  -webkit-user-select: none;
}

.control:active {
  background: #ff9d20;
  color: #111;
  transform: scale(0.92);
}

#overlay {
  position: fixed;
  inset: 0;
  z-index: 15;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: linear-gradient(
    180deg,
    rgba(5, 6, 18, 0.45),
    rgba(5, 6, 18, 0.92)
  );
}

.panel {
  width: min(430px, 100%);
  text-align: center;
  padding: 30px 22px;
  border-radius: 28px;
  border: 1px solid rgba(255, 180, 40, 0.65);
  background: rgba(9, 11, 25, 0.9);
  box-shadow: 0 0 60px rgba(255, 130, 0, 0.18);
  backdrop-filter: blur(15px);
}

.logo {
  font-size: clamp(36px, 9vw, 62px);
  font-weight: 1000;
  font-style: italic;
  line-height: 0.95;
  color: #ffb52e;
  text-shadow:
    3px 3px 0 #9c3600,
    0 0 30px #ff7b00;
}

.subtitle {
  margin-top: 14px;
  color: #d8d8e5;
  font-size: 13px;
  letter-spacing: 3px;
}

.description {
  margin: 22px 0;
  color: #b8bacb;
  font-size: 14px;
  line-height: 1.7;
}

#mainButton {
  width: 100%;
  padding: 17px;
  border: 0;
  border-radius: 15px;
  background: linear-gradient(135deg, #ffcc55, #ff7b18);
  color: #17100a;
  font-size: 18px;
  font-weight: 1000;
  letter-spacing: 1px;
  box-shadow: 0 8px 25px rgba(255, 130, 0, 0.25);
}

#mainButton:active {
  transform: scale(0.97);
}

#finalScore {
  margin: 18px 0;
  color: #ffc34d;
  font-size: 30px;
  font-weight: bold;
}

#toast {
  position: fixed;
  bottom: 105px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 11;
  background: rgba(10, 10, 20, 0.9);
  color: #ffcc55;
  padding: 12px 20px;
  border-radius: 15px;
  border: 1px solid #ffb52e;
  opacity: 0;
  transition: opacity 0.2s;
  pointer-events: none;
  white-space: nowrap;
}

#toast.show {
  opacity: 1;
}

@media (min-width: 800px) {
  #controls {
    max-width: 650px;
    margin: auto;
  }

  .control {
    width: 70px;
    height: 70px;
  }
}
</style>
</head>

<body>

<div id="game"></div>

<div id="loading">
  <h1>ANTONY DASH</h1>
  <p>Caricamento del mondo...</p>
</div>

<div id="hud">
  <div class="topbar">
    <div class="stat">
      <small>INCASSO</small>
      <strong id="money">0 €</strong>
    </div>

    <div class="stat">
      <small>DISTANZA</small>
      <strong id="distance">0 m</strong>
    </div>

    <div class="stat">
      <small>RECORD</small>
      <strong id="record">0</strong>
    </div>
  </div>
</div>

<div id="fatherMessage">
  LICENZIATI!
</div>

<div id="toast"></div>

<div id="controls">
  <div class="controlGroup">
    <button class="control" id="left">◀</button>
    <button class="control" id="right">▶</button>
  </div>

  <div class="controlGroup">
    <button class="control" id="slide">▼</button>
    <button class="control" id="jump">▲</button>
  </div>
</div>

<div id="overlay">
  <div class="panel">
    <div class="logo">ANTONY<br>DASH</div>
    <div class="subtitle">LA FUGA DEI 50 EURO</div>

    <div class="description" id="description">
      Corri, schiva gli ostacoli e raccogli le monete.
      <br>
      Francesco ti sta alle calcagna.
      <br><br>
      Raggiungi i <b>50 €</b> per vincere!
    </div>

    <div id="finalScore"></div>

    <button id="mainButton">INIZIA LA FUGA</button>
  </div>
</div>

<script type="module">
import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";

/* =========================
   ELEMENTI
========================= */

const loading = document.getElementById("loading");
const overlay = document.getElementById("overlay");
const hud = document.getElementById("hud");
const mainButton = document.getElementById("mainButton");
const description = document.getElementById("description");
const finalScore = document.getElementById("finalScore");
const moneyText = document.getElementById("money");
const distanceText = document.getElementById("distance");
const recordText = document.getElementById("record");
const fatherMessage = document.getElementById("fatherMessage");
const toast = document.getElementById("toast");

const lanes = [-2.4, 0, 2.4];

let scene;
let camera;
let renderer;
let clock;

let player;
let rival;
let father;

let road;
let roadLines = [];
let scenery = [];
let obstacles = [];
let coins = [];

let running = false;
let gameOver = false;

let lane = 1;
let playerX = 0;
let jumpY = 0;
let jumpVelocity = 0;
let sliding = false;
let slideTimer = 0;

let money = 0;
let distance = 0;
let speed = 18;
let spawnTimer = 0;
let coinTimer = 0;
let fatherTimer = 0;
let fatherActive = false;
let fatherCooldown = 0;
let fatherMessageTimer = 0;
let shake = 0;

let record = 0;

try {
  record = Number(localStorage.getItem("antonyDashRecord") || 0);
} catch(e) {
  record = 0;
}

recordText.textContent = record;

/* =========================
   COLORI E MATERIALI
========================= */

const mat = (color, roughness = 0.7, metalness = 0) =>
  new THREE.MeshStandardMaterial({
    color,
    roughness,
    metalness
  });

const materials = {
  road: mat(0x242633),
  line: mat(0xffc34d),
  white: mat(0xffffff),
  black: mat(0x11131c),
  red: mat(0xc92030),
  gold: mat(0xffbd36, 0.3, 0.5),
  skin: mat(0xd99b70),
  shirt: mat(0xffffff),
  blue: mat(0x1378d4),
  green: mat(0x24b86b),
  brown: mat(0x704020),
  gray: mat(0x6c7180),
  orange: mat(0xff851b),
  purple: mat(0x6e38bd)
};

/* =========================
   CREAZIONE OGGETTI 3D
========================= */

function box(parent, w, h, d, material, x, y, z) {
  const mesh = new THREE.Mesh(
    new THREE.BoxGeometry(w, h, d),
    material
  );

  mesh.position.set(x, y, z);
  mesh.castShadow = true;
  mesh.receiveShadow = true;

  parent.add(mesh);
  return mesh;
}

function sphere(parent, radius, material, x, y, z) {
  const mesh = new THREE.Mesh(
    new THREE.SphereGeometry(radius, 16, 12),
    material
  );

  mesh.position.set(x, y, z);
  mesh.castShadow = true;

  parent.add(mesh);
  return mesh;
}

function cylinder(parent, radiusTop, radiusBottom, height,
                  material, x, y, z) {
  const mesh = new THREE.Mesh(
    new THREE.CylinderGeometry(
      radiusTop,
      radiusBottom,
      height,
      12
    ),
    material
  );

  mesh.position.set(x, y, z);
  mesh.castShadow = true;

  parent.add(mesh);
  return mesh;
}

/* =========================
   PERSONAGGI
========================= */

function createCharacter(type) {
  const group = new THREE.Group();

  const isAntony = type === "antony";
  const isFather = type === "father";

  const shirtMaterial = isAntony
    ? materials.shirt
    : isFather
      ? materials.brown
      : materials.blue;

  const pantsMaterial = isFather
    ? materials.gray
    : materials.black;

  // Corpo
  box(
    group, 0.8, 1.0, 0.45,
    shirtMaterial, 0, 1.35, 0
  );

  // Testa
  sphere(
    group, 0.38, materials.skin,
    0, 2.15, 0
  );

  // Capelli
  sphere(
    group, 0.39, materials.black,
    0, 2.4, 0
  );

  // Barba
  if (isAntony || isFather) {
    sphere(
      group, 0.28, materials.black,
      0, 1.98, 0.18
    );
  }

  // Cappello da pizzaiolo
  if (isAntony) {
    cylinder(
      group, 0.35, 0.35, 0.12,
      materials.white, 0, 2.55, 0
    );

    sphere(
      group, 0.3, materials.white,
      0, 2.7, 0
    );
  }

  // Gambe
  const leg1 = box(
    group, 0.28, 0.8, 0.3,
    pantsMaterial, -0.22, 0.55, 0
  );

  const leg2 = box(
    group, 0.28, 0.8, 0.3,
    pantsMaterial, 0.22, 0.55, 0
  );

  // Scarpe
  box(
    group, 0.35, 0.18, 0.5,
    materials.black, -0.22, 0.1, 0.08
  );

  box(
    group, 0.35, 0.18, 0.5,
    materials.black, 0.22, 0.1, 0.08
  );

  // Braccia
  const arm1 = box(
    group, 0.22, 0.8, 0.25,
    shirtMaterial, -0.55, 1.35, 0
  );

  const arm2 = box(
    group, 0.22, 0.8, 0.25,
    shirtMaterial, 0.55, 1.35, 0
  );

  // Pala per Francesco
  if (!isAntony && !isFather) {
    box(
      group, 0.12, 1.4, 0.12,
      materials.brown, 0.75, 1.2, 0
    );

    box(
      group, 0.5, 0.25, 0.12,
      materials.gray, 0.75, 1.9, 0
    );
  }

  // Corpo del padre più robusto
  if (isFather) {
    box(
      group, 1.0, 0.35, 0.5,
      materials.brown, 0, 1.7, 0
    );
  }

  group.userData = {
    leg1,
    leg2,
    arm1,
    arm2,
    phase: Math.random() * 10
  };

  return group;
}

/* =========================
   SCENA
========================= */

function init() {
  scene = new THREE.Scene();

  scene.background = new THREE.Color(0x10172b);
  scene.fog = new THREE.Fog(0x10172b, 35, 110);

  camera = new THREE.PerspectiveCamera(
    65,
    window.innerWidth / window.innerHeight,
    0.1,
    200
  );

  camera.position.set(0, 6.5, 10);
  camera.lookAt(0, 1, -8);

  renderer = new THREE.WebGLRenderer({
    antialias: true,
    powerPreference: "high-performance"
  });

  renderer.setPixelRatio(
    Math.min(window.devicePixelRatio, 1.7)
  );

  renderer.setSize(
    window.innerWidth,
    window.innerHeight
  );

  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  renderer.outputColorSpace = THREE.SRGBColorSpace;

  document.getElementById("game").appendChild(
    renderer.domElement
  );

  clock = new THREE.Clock();

  // Luci
  const ambient = new THREE.HemisphereLight(
    0x9ebaff,
    0x25202c,
    2
  );

  scene.add(ambient);

  const sun = new THREE.DirectionalLight(
    0xffd4a0,
    3
  );

  sun.position.set(-8, 15, 8);
  sun.castShadow = true;

  sun.shadow.mapSize.set(1024, 1024);

  scene.add(sun);

  // Pavimento
  const ground = new THREE.Mesh(
    new THREE.PlaneGeometry(200, 200),
    mat(0x151a28)
  );

  ground.rotation.x = -Math.PI / 2;
  ground.position.y = -0.05;
  ground.position.z = -45;

  scene.add(ground);

  // Strada
  road = new THREE.Mesh(
    new THREE.PlaneGeometry(8.5, 200),
    materials.road
  );

  road.rotation.x = -Math.PI / 2;
  road.position.set(0, 0, -45);

  scene.add(road);

  // Linee corsie
  for (let i = 0; i < 30; i++) {
    for (const x of [-1.2, 1.2]) {
      const line = box(
        scene, 0.06, 0.03, 2.2,
        materials.line, x, 0.03, -i * 6
      );

      roadLines.push(line);
    }
  }

  // Bordi strada
  for (const x of [-4.3, 4.3]) {
    box(
      scene, 0.18, 0.12, 200,
      materials.gold, x, 0.05, -45
    );
  }

  // Edifici e luci
  for (let i = 0; i < 28; i++) {
    createScenery(-1);
    createScenery(1);
  }

  // Personaggi
  player = createCharacter("antony");
  player.position.set(0, 0, 2);

  scene.add(player);

  rival = createCharacter("francesco");
  rival.scale.setScalar(0.85);
  rival.position.set(0, 0, 8);

  scene.add(rival);

  father = createCharacter("father");
  father.scale.setScalar(1.1);
  father.position.set(0, -10, 8);

  scene.add(father);

  window.addEventListener("resize", onResize);

  loading.style.display = "none";

  animate();
}

/* =========================
   SCENARIO
========================= */

function createScenery(side) {
  const group = new THREE.Group();

  const height = 4 + Math.random() * 10;
  const width = 2 + Math.random() * 4;

  const buildingMaterial = mat(
    new THREE.Color().setHSL(
      Math.random(),
      0.35,
      0.25
    )
  );

  box(
    group,
    width,
    height,
    3,
    buildingMaterial,
    0,
    height / 2,
    0
  );

  // Finestre luminose
  for (let y = 1; y < height - 0.5; y += 1.5) {
    for (let x = -width / 2 + 0.5;
         x < width / 2;
         x += 1) {

      box(
        group, 0.35, 0.45, 0.05,
        Math.random() > 0.5
          ? mat(0xffbd52, 0.3, 0)
          : mat(0x29334d),
        x, y, 1.53
      );
    }
  }

  group.position.set(
    side * (7 + Math.random() * 8),
    0,
    -Math.random() * 150
  );

  scene.add(group);
  scenery.push(group);
}

/* =========================
   OSTACOLI
========================= */

function createObstacle() {
  const group = new THREE.Group();

  const type = Math.floor(Math.random() * 5);

  if (type === 0) {
    // Cassa
    box(
      group, 1.4, 1.4, 1.2,
      materials.brown, 0, 0.7, 0
    );

    box(
      group, 1.45, 0.12, 1.25,
      materials.orange, 0, 0.7, 0
    );

  } else if (type === 1) {
    // Barriera
    box(
      group, 2.0, 0.7, 0.5,
      materials.red, 0, 0.8, 0
    );

    box(
      group, 2.2, 0.15, 0.6,
      materials.white, 0, 0.8, 0
    );

  } else if (type === 2) {
    // Furgone
    box(
      group, 1.8, 1.6, 3.0,
      materials.white, 0, 0.9, 0
    );

    box(
      group, 1.6, 0.7, 0.5,
      materials.blue, 0, 1.2, 1.55
    );

    for (const x of [-0.7, 0.7]) {
      cylinder(
        group, 0.35, 0.35, 0.2,
        materials.black, x, 0.3, 0.9
      );

      cylinder(
        group, 0.35, 0.35, 0.2,
        materials.black, x, 0.3, -0.9
      );
    }

  } else if (type === 3) {
    // Ostacolo basso da saltare
    box(
      group, 2.0, 0.45, 0.7,
      materials.orange, 0, 0.25, 0
    );

  } else {
    // Tavolo
    box(
      group, 1.7, 0.2, 1.5,
      materials.brown, 0, 1.0, 0
    );

    for (const x of [-0.7, 0.7]) {
      for (const z of [-0.5, 0.5]) {
        box(
          group, 0.12, 1.0, 0.12,
          materials.black, x, 0.5, z
        );
      }
    }
  }

  group.position.set(
    lanes[Math.floor(Math.random() * 3)],
    0,
    -75
  );

  group.userData.type = type;
  group.userData.passed = false;

  scene.add(group);
  obstacles.push(group);
}

/* =========================
   MONETE
========================= */

function createCoin() {
  const group = new THREE.Group();

  const coin = new THREE.Mesh(
    new THREE.CylinderGeometry(
      0.42, 0.42, 0.12, 24
    ),
    materials.gold
  );

  coin.rotation.x = Math.PI / 2;
  coin.castShadow = true;

  group.add(coin);

  const symbol = new THREE.Mesh(
    new THREE.TorusGeometry(0.22, 0.05, 8, 20),
    materials.orange
  );

  symbol.position.z = 0.08;
  group.add(symbol);

  group.position.set(
    lanes[Math.floor(Math.random() * 3)],
    1.2,
    -75
  );

  group.userData.collected = false;

  scene.add(group);
  coins.push(group);
}

/* =========================
   PARTITA
========================= */

function startGame() {
  running = true;
  gameOver = false;

  lane = 1;
  playerX = 0;

  jumpY = 0;
  jumpVelocity = 0;

  sliding = false;
  slideTimer = 0;

  money = 0;
  distance = 0;

  speed = 18;

  spawnTimer = 0.8;
  coinTimer = 0.5;

  fatherTimer = 0;
  fatherActive = false;
  fatherCooldown = 0;
  fatherMessageTimer = 0;

  shake = 0;

  fatherMessage.classList.remove("show");

  for (const obj of obstacles) {
    scene.remove(obj);
  }

  for (const obj of coins) {
    scene.remove(obj);
  }

  obstacles = [];
  coins = [];

  player.position.set(0, 0, 2);
  rival.position.set(0, 0, 8);
  father.position.set(0, -10, 8);

  overlay.style.display = "none";
  hud.style.display = "block";

  mainButton.textContent = "RIPROVA";

  updateHUD();

  clock.getDelta();
}

/* =========================
   COMANDI
========================= */

function moveLeft() {
  if (!running) return;

  lane = Math.max(0, lane - 1);
}

function moveRight() {
  if (!running) return;

  lane = Math.min(2, lane + 1);
}

function jump() {
  if (!running || jumpY > 0) return;

  sliding = false;
  jumpVelocity = 10.5;
}

function slide() {
  if (!running || jumpY > 0) return;

  sliding = true;
  slideTimer = 0.75;
}

document.getElementById("left").addEventListener(
  "pointerdown", e => {
    e.preventDefault();
    moveLeft();
  }
);

document.getElementById("right").addEventListener(
  "pointerdown", e => {
    e.preventDefault();
    moveRight();
  }
);

document.getElementById("jump").addEventListener(
  "pointerdown", e => {
    e.preventDefault();
    jump();
  }
);

document.getElementById("slide").addEventListener(
  "pointerdown", e => {
    e.preventDefault();
    slide();
  }
);

window.addEventListener("keydown", e => {
  if (e.repeat) return;

  if (e.key === "ArrowLeft" || e.key === "a") {
    moveLeft();
  }

  if (e.key === "ArrowRight" || e.key === "d") {
    moveRight();
  }

  if (e.key === "ArrowUp" || e.key === " " || e.key === "w") {
    jump();
  }

  if (e.key === "ArrowDown" || e.key === "s") {
    slide();
  }
});

mainButton.addEventListener("click", startGame);

/* =========================
   PADRE DI FRANCESCO
========================= */

function spawnFather() {
  fatherActive = true;

  father.position.set(
    lanes[lane],
    0,
    7
  );

  fatherMessageTimer = 2.3;

  fatherMessage.textContent = "LICENZIATI!";
  fatherMessage.classList.add("show");

  showToast("IL PADRE DI FRANCESCO È ARRIVATO!");

  shake = 0.5;
}

function updateFather(dt) {
  fatherCooldown -= dt;

  if (!fatherActive) {
    fatherTimer += dt;

    // Controllo casuale: 35% ogni opportunità
    if (
      fatherTimer > 9 &&
      fatherCooldown <= 0
    ) {
      fatherTimer = 0;

      if (Math.random() < 0.35) {
        spawnFather();
      }
    }

    father.position.y = -10;
    return;
  }

  father.position.x += (
    playerX - father.position.x
  ) * dt * 2.5;

  father.position.z -= dt * 7;

  fatherMessageTimer -= dt;

  if (fatherMessageTimer <= 0) {
    fatherMessage.classList.remove("show");
  }

  if (father.position.z < 3) {
    fatherActive = false;
    fatherCooldown = 18;

    father.position.y = -10;

    showToast("IL PADRE DI FRANCESCO È SPARITO!");
  }
}

/* =========================
   ANIMAZIONE PERSONAGGI
========================= */

function animateCharacter(character, dt) {
  const data = character.userData;

  data.phase += dt * 12;

  const swing = Math.sin(data.phase) * 0.55;

  data.leg1.rotation.x = swing;
  data.leg2.rotation.x = -swing;

  data.arm1.rotation.x = -swing;
  data.arm2.rotation.x = swing;
}

/* =========================
   AGGIORNAMENTO GIOCO
========================= */

function update(dt) {
  if (!running) return;

  speed += dt * 0.18;
  distance += speed * dt;

  // Movimento corsie
  const targetX = lanes[lane];

  playerX += (
    targetX - playerX
  ) * Math.min(1, dt * 12);

  player.position.x = playerX;

  // Salto
  if (jumpY > 0 || jumpVelocity > 0) {
    jumpVelocity -= 24 * dt;
    jumpY += jumpVelocity * dt;

    if (jumpY < 0) {
      jumpY = 0;
      jumpVelocity = 0;
    }
  }

  player.position.y = jumpY;

  // Scivolata
  if (sliding) {
    slideTimer -= dt;

    player.scale.y = 0.55;

    if (slideTimer <= 0) {
      sliding = false;
      player.scale.y = 1;
    }
  } else {
    player.scale.y = 1;
  }

  // Linee strada
  for (const line of roadLines) {
    line.position.z += speed * dt;

    if (line.position.z > 8) {
      line.position.z -= 180;
    }
  }

  // Scenario
  for (const group of scenery) {
    group.position.z += speed * dt;

    if (group.position.z > 20) {
      group.position.z = -150 - Math.random() * 40;
    }
  }

  // Ostacoli
  spawnTimer -= dt;

  if (spawnTimer <= 0) {
    createObstacle();

    spawnTimer = Math.max(
      0.65,
      1.45 - speed * 0.025
    );
  }

  for (let i = obstacles.length - 1; i >= 0; i--) {
    const obj = obstacles[i];

    obj.position.z += speed * dt;

    if (
      !obj.userData.passed &&
      obj.position.z > 2
    ) {
      obj.userData.passed = true;
      distance += 8;
    }

    // Collisione
    const dx = Math.abs(
      obj.position.x - playerX
    );

    const dz = Math.abs(
      obj.position.z - 2
    );

    if (dx < 1.05 && dz < 1.25) {
      const type = obj.userData.type;

      // Ostacolo basso: si può saltare
      if (type === 3 && jumpY > 0.7) {
        continue;
      }

      // Barriera: si può scivolare
      if (type === 1 && sliding) {
        continue;
      }

      endGame(false);
      return;
    }

    if (obj.position.z > 15) {
      scene.remove(obj);
      obstacles.splice(i, 1);
    }
  }

  // Monete
  coinTimer -= dt;

  if (coinTimer <= 0) {
    createCoin();
    coinTimer = 0.55;
  }

  for (let i = coins.length - 1; i >= 0; i--) {
    const coin = coins[i];

    coin.position.z += speed * dt;
    coin.rotation.y += dt * 3;

    const dx = Math.abs(
      coin.position.x - playerX
    );

    const dz = Math.abs(
      coin.position.z - 2
    );

    const dy = Math.abs(
      coin.position.y - (1.2 + jumpY)
    );

    if (
      dx < 0.85 &&
      dz < 1.2 &&
      dy < 1.5
    ) {
      money++;

      scene.remove(coin);
      coins.splice(i, 1);

      updateHUD();

      if (money >= 50) {
        endGame(true);
        return;
      }

      continue;
    }

    if (coin.position.z > 15) {
      scene.remove(coin);
      coins.splice(i, 1);
    }
  }

  // Francesco
  rival.position.z = 8 - Math.sin(distance * 0.04) * 0.4;
  rival.position.x += (
    playerX - rival.position.x
  ) * dt * 1.5;

  animateCharacter(player, dt);
  animateCharacter(rival, dt);

  // Padre
  updateFather(dt);

  if (fatherActive) {
    animateCharacter(father, dt);
  }

  // Camera dinamica
  camera.position.x += (
    playerX * 0.35 - camera.position.x
  ) * dt * 2;

  camera.position.y = 6.5 + jumpY * 0.15;

  camera.lookAt(
    playerX * 0.25,
    1.2 + jumpY * 0.15,
    -8
  );

  // Shake
  if (shake > 0) {
    shake -= dt;

    camera.position.x += (
      Math.random() - 0.5
    ) * shake * 0.8;
  }

  updateHUD();
}

/* =========================
   HUD
========================= */

function updateHUD() {
  moneyText.textContent = money + " €";
  distanceText.textContent = Math.floor(distance) + " m";
  recordText.textContent = record;
}

/* =========================
   GAME OVER / VITTORIA
========================= */

function endGame(won) {
  running = false;
  gameOver = true;

  if (money > record) {
    record = money;

    try {
      localStorage.setItem(
        "antonyDashRecord",
        record
      );
    } catch(e) {}
  }

  updateHUD();

  hud.style.display = "none";
  overlay.style.display = "flex";

  if (won) {
    document.querySelector(".logo").innerHTML =
      "50 EURO<br>RAGGIUNTI!";

    description.innerHTML =
      "Hai conquistato l'incasso della giornata!<br>" +
      "Francesco non ti prenderà mai!";

    mainButton.textContent = "GIOCA ANCORA";

  } else {
    document.querySelector(".logo").innerHTML =
      "GAME<br>OVER";

    description.innerHTML =
      "Gli ostacoli ti hanno fermato.<br>" +
      "Ma Antony non molla mai!";

    mainButton.textContent = "RIPROVA";
  }

  finalScore.textContent =
    money + " € RACCOLTI";

  showToast(
    won ? "VITTORIA!" : "FINE DELLA FUGA!"
  );
}

/* =========================
   MESSAGGI
========================= */

let toastTimer;

function showToast(message) {
  toast.textContent = message;
  toast.classList.add("show");

  clearTimeout(toastTimer);

  toastTimer = setTimeout(() => {
    toast.classList.remove("show");
  }, 2200);
}

/* =========================
   RESIZE
========================= */

function onResize() {
  if (!camera || !renderer) return;

  camera.aspect =
    window.innerWidth / window.innerHeight;

  camera.updateProjectionMatrix();

  renderer.setSize(
    window.innerWidth,
    window.innerHeight
  );
}

/* =========================
   LOOP
========================= */

function animate() {
  requestAnimationFrame(animate);

  const dt = Math.min(
    clock.getDelta(),
    0.05
  );

  update(dt);

  renderer.render(scene, camera);
}

/* =========================
   AVVIO SICURO
========================= */

try {
  init();
} catch (error) {
  console.error(error);

  loading.classList.add("error");

  loading.innerHTML =
    "<h1>ANTONY DASH</h1>" +
    "<p>Il gioco non è riuscito ad avviarsi.</p>" +
    "<p>Controlla la connessione internet e ricarica la pagina.</p>" +
    "<p style='font-size:12px;margin-top:20px'>" +
    String(error.message || error) +
    "</p>";
}
</script>

