<body>
<div id="game">

<div id="hud">
 <div class="panel">
  <small>PUNTEGGIO</small>
  <strong id="score">0</strong>
 </div>
 <div class="panel">
  <small>INCASSO</small>
  <strong id="money">0 €</strong>
 </div>
 <div class="panel">
  <small>OBIETTIVO</small>
  <strong>50 €</strong>
 </div>
</div>

<button id="sound">🔊</button>

<div id="message">
 <div class="window">
  <h1>ANTONY DASH</h1>
  <h2>LA FUGA DEI 50 EURO</h2>
  <div class="description">
   🍕 Sei il pizzaiolo di Antony.<br>
   Francesco, il lavapiatti, ti sta cercando!<br><br>
   Raccogli 50 euro, schiva gli ostacoli e cerca di non farti prendere!<br><br>
   <b>Comandi:</b><br>
   ← → Cambia corsia<br>
   ↑ Salta<br>
   ↓ Scivola
  </div>
