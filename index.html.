<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>
/* ==================================
   ANTONY DASH - GAME ENGINE
================================== */

const game=document.getElementById("game");
const scoreUI=document.getElementById("score");
const moneyUI=document.getElementById("money");
const message=document.getElementById("message");
const mainButton=document.getElementById("mainButton");

let scene,camera,renderer;
let player,francesco;
let objects=[];
let decorations=[];
let clock=new THREE.Clock();

let running=false;
let lane=1;
let score=0;
let money=0;
let speed=19;
let jumpVelocity=0;
let jumpHeight=0;
let sliding=false;
let slideTime=0;
let spawnTimer=0;
let coinTimer=0;
let soundOn=true;
let audioContext=null;
let gameTime=0;

const lanes=[-2.7,0,2.7];

const materials={
 road:new THREE.MeshStandardMaterial({color:0x25263c,roughness:0.8}),
 white:new THREE.MeshStandardMaterial({color:0xffffff}),
 gold:new THREE.MeshStandardMaterial({color:0xffc928,metalness:.65,roughness:.25}),
 red:new THREE.MeshStandardMaterial({color:0xe33c35}),
 blue:new THREE.MeshStandardMaterial({color:0x2389e8}),
 black:new THREE.MeshStandardMaterial({color:0x181820}),
 skin:new THREE.MeshStandardMaterial({color:0xffc18d}),
 chef:new THREE.MeshStandardMaterial({color:0xffffff}),
 dark:new THREE.MeshStandardMaterial({color:0x252525})
};

/* ==================================
   THREE JS INITIALIZATION
================================== */

function init(){

 scene=new THREE.Scene();
 scene.background=new THREE.Color(0x111326);
 scene.fog=new THREE.Fog(0x111326,25,100);

 camera=new THREE.PerspectiveCamera(
  65,window.innerWidth/window.innerHeight,.1,150
 );
 camera.position.set(0,6.5,11);
 camera.lookAt(0,1,0);

 renderer=new THREE.WebGLRenderer({antialias:true});
 renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
 renderer.setSize(window.innerWidth,window.innerHeight);
 renderer.shadowMap.enabled=true;
 renderer.shadowMap.type=THREE.PCFSoftShadowMap;
 game.insertBefore(renderer.domElement,game.firstChild);

 const ambient=new THREE.HemisphereLight(0xffffff,0x343455,1.5);
 scene.add(ambient);

 const light=new THREE.DirectionalLight(0xffffff,2);
 light.position.set(-5,12,8);
 light.castShadow=true;
 scene.add(light);

 createWorld();
 createPlayer();
 createFrancesco();

 window.addEventListener("resize",resize);
}

/* ==================================
   WORLD
================================== */

function createWorld(){

 const floor=new THREE.Mesh(
  new THREE.PlaneGeometry(200,200),
  new THREE.MeshStandardMaterial({color:0x111522})
 );
 floor.rotation.x=-Math.PI/2;
 floor.position.y=-.12;
 floor.position.z=-40;
 scene.add(floor);

 const road=new THREE.Mesh(
  new THREE.BoxGeometry(9,.2,150),
  materials.road
 );
 road.position.set(0,0,-40);
 road.receiveShadow=true;
 scene.add(road);

 // Linee divisorie delle corsie
 for(let x of [-1.35,1.35]){
  const line=new THREE.Mesh(
   new THREE.BoxGeometry(.055,.025,150),
   new THREE.MeshBasicMaterial({color:0xffffff})
  );
  line.position.set(x,.115,-40);
  scene.add(line);
 }

 // Bordo stradale
 for(let x of [-4.7,4.7]){
  const edge=new THREE.Mesh(
   new THREE.BoxGeometry(.35,.35,150),
   new THREE.MeshStandardMaterial({color:0xffa52d})
  );
  edge.position.set(x,.05,-40);
  scene.add(edge);
 }

 // Edifici laterali
 for(let side of [-1,1]){
  for(let i=0;i<14;i++){
   const height=5+Math.random()*10;
   const building=new THREE.Mesh(
    new THREE.BoxGeometry(4,height,5),
    new THREE.MeshStandardMaterial({
     color:new THREE.Color().setHSL(
      Math.random()*.15+.58,.25,.2+Math.random()*.15
     )
    })
   );
   building.position.set(
    side*(8+Math.random()*4),
    height/2-0.1,
    -i*10-5
   );
   scene.add(building);
   decorations.push(building);
  }
 }

 // Lampioni
 for(let side of [-1,1]){
  for(let i=0;i<12;i++){
   const lamp=new THREE.Group();

   const pole=new THREE.Mesh(
    new THREE.CylinderGeometry(.08,.12,4,8),
    materials.dark
   );
   pole.position.y=2;
   lamp.add(pole);

   const arm=new THREE.Mesh(
    new THREE.BoxGeometry(.8,.08,.08),
    materials.dark
   );
   arm.position.set(-side*.3,3.9,0);
   lamp.add(arm);

   const bulb=new THREE.Mesh(
    new THREE.SphereGeometry(.22,10,10),
    new THREE.MeshBasicMaterial({color:0xffe9a0})
   );
   bulb.position.set(-side*.65,3.8,0);
   lamp.add(bulb);

   lamp.position.set(side*6,0,-i*12);
   scene.add(lamp);
   decorations.push(lamp);
  }
 }
}

/* ==================================
   CHARACTER CREATION
================================== */

function createCharacter(color){

 const group=new THREE.Group();

 function box(w,h,d,mat,x,y,z){
  const mesh=new THREE.Mesh(
   new THREE.BoxGeometry(w,h,d),mat
  );
  mesh.position.set(x,y,z);
  mesh.castShadow=true;
  group.add(mesh);
  return mesh;
 }

 // Corpo
 box(.85,1,.5,color,0,1.05,0);

 // Testa
 const head=new THREE.Mesh(
  new THREE.SphereGeometry(.43,18,18),
  materials.skin
 );
 head.position.y=1.9;
 head.castShadow=true;
 group.add(head);

 // Occhi
 for(let x of [-.15,.15]){
  box(.07,.08,.05,materials.black,x,1.98,.38);
 }

 // Cappello da pizzaiolo
 const hat=new THREE.Mesh(
  new THREE.CylinderGeometry(.38,.35,.17,16),
  materials.chef
 );
 hat.position.y=2.38;
 group.add(hat);

 const topHat=new THREE.Mesh(
  new THREE.SphereGeometry(.34,16,12,0,Math.PI*2,0,Math.PI/2),
  materials.chef
 );
 topHat.scale.y=.75;
 topHat.position.y=2.48;
 group.add(topHat);

 // Braccia
 const arms=[];
 for(let x of [-.58,.58]){
  const arm=box(.22,.8,.23,materials.skin,x,1.15,0);
  arms.push(arm);
 }

 // Gambe
 const legs=[];
 for(let x of [-.23,.23]){
  const leg=box(.25,.75,.3,materials.dark,x,.35,0);
  legs.push(leg);
 }

 group.userData.arms=arms;
 group.userData.legs=legs;

 return group;
}

function createPlayer(){

 player=createCharacter(
  new THREE.MeshStandardMaterial({color:0xe63939})
 );

 player.position.set(0,0,3);
 scene.add(player);
}

function createFrancesco(){

 francesco=createCharacter(
  new THREE.MeshStandardMaterial({color:0x3286dc})
 );

 francesco.scale.set(.85,.85,.85);
 francesco.position.set(0,0,7.8);
 scene.add(francesco);

 // Pala da lavapiatti
 const handle=new THREE.Mesh(
  new THREE.CylinderGeometry(.07,.07,1.5,8),
  new THREE.MeshStandardMaterial({color:0x8c542a})
 );
 handle.position.set(.8,1.1,0);
 francesco.add(handle);

 const shovel=new THREE.Mesh(
  new THREE.BoxGeometry(.55,.6,.08),
  new THREE.MeshStandardMaterial({color:0xbfc6d0,metalness:.8})
 );
 shovel.position.set(.8,1.95,0);
 francesco.add(shovel);
}

/* ==================================
   OBJECT CREATION
================================== */

function createObstacle(type,x,z){

 const group=new THREE.Group();

 if(type==="low"){
  // Cassa bassa: bisogna saltare
  const box=new THREE.Mesh(
   new THREE.BoxGeometry(1.5,.9,1),
   new THREE.MeshStandardMaterial({color:0xe8a23a})
  );
  box.position.y=.45;
  box.castShadow=true;
  group.add(box);

 }else if(type==="high"){
  // Ostacolo sospeso: bisogna scivolare
  const bar=new THREE.Mesh(
   new THREE.BoxGeometry(1.7,.45,.7),
   new THREE.MeshStandardMaterial({color:0xd63838})
  );
  bar.position.y=1.65;
  group.add(bar);

  for(let side of [-.7,.7]){
   const support=new THREE.Mesh(
    new THREE.BoxGeometry(.15,1.7,.15),
    materials.dark
   );
   support.position.set(side,.85,0);
   group.add(support);
  }

 }else if(type==="barrier"){
  const wall=new THREE.Mesh(
   new THREE.BoxGeometry(1.8,2.2,.5),
   new THREE.MeshStandardMaterial({color:0x9a313b})
  );
  wall.position.y=1.1;
  group.add(wall);

 }else if(type==="pizza"){
  const pizza=new THREE.Mesh(
   new THREE.CylinderGeometry(.8,.8,.18,24),
   new THREE.MeshStandardMaterial({color:0xe8a73c})
  );
  pizza.position.y=.8;
  group.add(pizza);

  const sauce=new THREE.Mesh(
   new THREE.CylinderGeometry(.68,.68,.06,24),
   new THREE.MeshStandardMaterial({color:0xd94424})
  );
  sauce.position.y=.92;
  group.add(sauce);

  for(let i=0;i<5;i++){
   const topping=new THREE.Mesh(
    new THREE.SphereGeometry(.12,8,8),
    materials.red
   );
   topping.position.set(
    Math.sin(i*1.2)*.4,1.02,
    Math.cos(i*1.2)*.4
   );
   group.add(topping);
  }
 }

 group.position.set(x,0,z);
 group.userData.type=type;
 group.userData.kind="obstacle";

 scene.add(group);
 objects.push(group);
}

function createCoin(x,z){

 const coin=new THREE.Group();

 const ring=new THREE.Mesh(
  new THREE.TorusGeometry(.38,.12,10,20),
  materials.gold
 );
 ring.rotation.y=Math.PI/2;
 coin.add(ring);

 const center=new THREE.Mesh(
  new THREE.CylinderGeometry(.22,.22,.12,16),
  materials.gold
 );
 center.rotation.x=Math.PI/2;
 coin.add(center);

 coin.position.set(x,1.2,z);
 coin.userData.kind="coin";
 coin.userData.collected=false;

 scene.add(coin);
 objects.push(coin);
}

/* ==================================
   GAMEPLAY
================================== */

function moveLeft(){
 if(!running)return;
 lane=Math.max(0,lane-1);
 playSound(300);
}

function moveRight(){
 if(!running)return;
 lane=Math.min(2,lane+1);
 playSound(400);
}

function jump(){
 if(!running || jumpHeight>0)return;
 if(sliding)return;
 jumpVelocity=11;
 playSound(550);
}

function slide(){
 if(!running || sliding)return;
 sliding=true;
 slideTime=.75;
 playSound(200);
}

function spawnObstacle(){

 const laneIndex=Math.floor(Math.random()*3);
 const types=["low","high","barrier","pizza"];
 const type=types[Math.floor(Math.random()*types.length)];

 createObstacle(type,lanes[laneIndex],-55);

 // A volte una seconda barriera
 if(Math.random()<.17){
  let second=(laneIndex+1+Math.floor(Math.random()*2))%3;
  createObstacle("barrier",lanes[second],-65);
 }
}

function spawnCoins(){

 const laneIndex=Math.floor(Math.random()*3);
 const x=lanes[laneIndex];

 for(let i=0;i<5;i++){
  createCoin(x,-35-i*2.2);
 }
}

/* ==================================
   COLLISION
================================== */

function checkCollision(obj){

 const distanceZ=Math.abs(obj.position.z-player.position.z);
 const distanceX=Math.abs(obj.position.x-player.position.x);

 if(distanceZ>1.05 || distanceX>1.05)return false;

 if(obj.userData.kind==="coin"){
  return true;
 }

 const type=obj.userData.type;

 if(type==="low"){
  return jumpHeight<1.05;
 }

 if(type==="high"){
  return !sliding;
 }

 if(type==="barrier" || type==="pizza"){
  return jumpHeight<.8;
 }

 return false;
}

/* ==================================
   GAME LOOP
================================== */

function update(delta){

 if(!running)return;

 gameTime+=delta;

 // Velocità crescente
 speed=Math.min(32,19+gameTime*.18);

 // Punteggio
 score+=delta*speed*.35;
 scoreUI.textContent=Math.floor(score);

 // Movimento giocatore
 const targetX=lanes[lane];
 player.position.x+=
  (targetX-player.position.x)*Math.min(1,delta*12);

 // Salto
 if(jumpHeight>0 || jumpVelocity>0){
  jumpVelocity-=25*delta;
  jumpHeight+=jumpVelocity*delta;

  if(jumpHeight<0){
   jumpHeight=0;
   jumpVelocity=0;
  }
 }
 player.position.y=jumpHeight;

 // Scivolata
 if(sliding){
  slideTime-=delta;
  player.scale.y=.55;

  if(slideTime<=0){
   sliding=false;
   player.scale.y=1;
  }
 }

 // Animazione gambe
 const legs=player.userData.legs;
 const arms=player.userData.arms;

 legs.forEach((leg,i)=>{
  leg.rotation.x=Math.sin(gameTime*12+i*Math.PI)*.65;
 });
 arms.forEach((arm,i)=>{
  arm.rotation.x=Math.sin(gameTime*12+i*Math.PI+1)*.55;
 });

 // Animazione Francesco
 francesco.position.x=Math.sin(gameTime*2)*.15;
 francesco.rotation.z=Math.sin(gameTime*4)*.08;

 // Camera
 camera.position.x+=(player.position.x*.25-camera.position.x)*delta*3;
 camera.lookAt(player.position.x*.2,1,0);

 // Generazione ostacoli
 spawnTimer-=delta;
 if(spawnTimer<=0){
  spawnObstacle();
  spawnTimer=Math.max(.65,1.45-gameTime*.006)+Math.random()*.45;
 }

 // Generazione monete
 coinTimer-=delta;
 if(coinTimer<=0){
  spawnCoins();
  coinTimer=2.4+Math.random()*1.5;
 }

 // Movimento oggetti
 for(let i=objects.length-1;i>=0;i--){

  const obj=objects[i];
  obj.position.z+=speed*delta;

  if(obj.userData.kind==="coin"){
   obj.rotation.y+=delta*3;
   obj.position.y=1.2+Math.sin(gameTime*5+obj.position.z)*.12;
  }

  if(checkCollision(obj)){

   if(obj.userData.kind==="coin"){
    money++;
    moneyUI.textContent=money+" €";
    playSound(850);

    scene.remove(obj);
    objects.splice(i,1);

    if(money>=50){
     victory();
     return;
    }

   }else{
    gameOver();
    return;
   }
  }

  if(obj.position.z>12){
   scene.remove(obj);
   objects.splice(i,1);
  }
 }

 // Decorazioni
 decorations.forEach(obj=>{
  obj.position.z+=speed*delta;
  if(obj.position.z>15)obj.position.z-=140;
 });

 // Strada e mondo
 renderer.render(scene,camera);
}

function animate(){
 requestAnimationFrame(animate);
 const delta=Math.min(clock.getDelta(),.04);
 update(delta);
 if(!running)renderer.render(scene,camera);
}

/* ==================================
   AUDIO
================================== */

function playSound(frequency){

 if(!soundOn)return;

 try{
  if(!audioContext){
   audioContext=new (window.AudioContext||window.webkitAudioContext)();
  }

  if(audioContext.state==="suspended")audioContext.resume();

  const oscillator=audioContext.createOscillator();
  const gain=audioContext.createGain();

  oscillator.type="sine";
  oscillator.frequency.value=frequency;

  gain.gain.setValueAtTime(.12,audioContext.currentTime);
  gain.gain.exponentialRampToValueAtTime(
   .001,audioContext.currentTime+.16
  );

  oscillator.connect(gain);
  gain.connect(audioContext.destination);

  oscillator.start();
  oscillator.stop(audioContext.currentTime+.17);

 }catch(e){}
}

/* ==================================
   GAME STATES
================================== */

function startGame(){

 objects.forEach(o=>scene.remove(o));
 objects=[];
 
 // Reset posizione e punteggi
 score=0;
 money=0;
 speed=19;
 gameTime=0;
 lane=1;
 jumpHeight=0;
 jumpVelocity=0;
 sliding=false;
 slideTime=0;
 spawnTimer=.8;
 coinTimer=1;

 player.position.set(0,0,3);
 player.scale.set(1,1,1);
 francesco.position.set(0,0,7.8);
 camera.position.set(0,6.5,11);

 scoreUI.textContent="0";
 moneyUI.textContent="0 €";

 message.classList.add("hidden");
 running=true;
 clock.getDelta();
}

function gameOver(){

 running=false;

 message.innerHTML=`
 <div class="window">
  <h1>GAME OVER</h1>
  <h2>FRANCESCO TI HA PRESO! 😂</h2>
  <div class="description">
   🍕 La tua fuga è finita!<br><br>
   Punteggio: <b>${Math.floor(score)}</b><br>
   Soldi raccolti: <b>${money} €</b><br><br>
   Francesco ha ancora la pala in mano...<br>
   Devi riprovarci!
  </div>
  <button id="mainButton" onclick="startGame()">RIPROVA!</button>
 </div>`;

 message.classList.remove("hidden");
}

function victory(){

 running=false;

 message.innerHTML=`
 <div class="window">
  <h1>VITTORIA!</h1>
  <h2>HAI PRESO I 50 EURO! 💰</h2>
  <div class="description">
   🏆 MISSIONE COMPLETATA!<br><br>
   Hai raccolto tutti i 50 euro!<br>
   Francesco è rimasto senza parole.<br><br>
   Punteggio finale: <b>${Math.floor(score)}</b><br>
   Incasso: <b>50 €</b><br><br>
   Antony è fiero di te!
  </div>
  <button id="mainButton" onclick="startGame()">GIOCA ANCORA</button>
 </div>`;

 message.classList.remove("hidden");
}

/* ==================================
   CONTROLS
================================== */

document.getElementById("left").addEventListener("pointerdown",e=>{
 e.preventDefault();moveLeft();
});

document.getElementById("right").addEventListener("pointerdown",e=>{
 e.preventDefault();moveRight();
});

document.getElementById("jump").addEventListener("pointerdown",e=>{
 e.preventDefault();jump();
});

document.getElementById("slide").addEventListener("pointerdown",e=>{
 e.preventDefault();slide();
});

document.addEventListener("keydown",e=>{

 if(["ArrowLeft","ArrowRight","ArrowUp","ArrowDown"," "].includes(e.key)){
  e.preventDefault();
 }

 if(e.key==="ArrowLeft" || e.key==="a")moveLeft();
 if(e.key==="ArrowRight" || e.key==="d")moveRight();
 if(e.key==="ArrowUp" || e.key==="w" || e.key===" ")jump();
 if(e.key==="ArrowDown" || e.key==="s")slide();

});

let touchStartX=0;
let touchStartY=0;

game.addEventListener("touchstart",e=>{
 const t=e.changedTouches[0];
 touchStartX=t.clientX;
 touchStartY=t.clientY;
},{passive:true});

game.addEventListener("touchend",e=>{

 if(!running)return;

 const t=e.changedTouches[0];
 const dx=t.clientX-touchStartX;
 const dy=t.clientY-touchStartY;

 if(Math.max(Math.abs(dx),Math.abs(dy))<30)return;

 if(Math.abs(dx)>Math.abs(dy)){
  if(dx>0)moveRight();
  else moveLeft();
 }else{
  if(dy<0)jump();
  else slide();
 }

},{passive:true});

/* ==================================
   SETTINGS
================================== */

document.getElementById("sound").onclick=()=>{

 soundOn=!soundOn;

 document.getElementById("sound").textContent=
  soundOn?"🔊":"🔇";

};

mainButton.onclick=startGame;

/* ==================================
   RESIZE
================================== */

function resize(){

 if(!camera || !renderer)return;

 camera.aspect=window.innerWidth/window.innerHeight;
 camera.updateProjectionMatrix();

 renderer.setSize(window.innerWidth,window.innerHeight);
 renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
}

/* ==================================
   START
================================== */

init();
animate();

</script>
