<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>ANTONY DASH</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#111;color:white;font-family:Arial}
#game{position:fixed;inset:0}
canvas{display:block}
#hud{position:absolute;top:15px;width:100%;display:flex;justify-content:space-around;font-size:20px;font-weight:bold;text-shadow:2px 2px 4px black;pointer-events:none}
#message{position:absolute;top:35%;width:100%;text-align:center;font-size:32px;font-weight:900;text-shadow:2px 2px 5px black}
#start{position:absolute;top:55%;left:50%;transform:translateX(-50%);background:#e53935;color:white;border:0;padding:16px 30px;border-radius:15px;font-size:22px;font-weight:bold}
#controls{position:absolute;bottom:20px;width:100%;display:flex;justify-content:space-around}
#controls button{width:60px;height:60px;border:2px solid white;border-radius:50%;background:#222b;color:white;font-size:25px}
</style>
</head>
<body>
<div id="game"></div>
<div id="hud">
<span>⭐ <b id="score">0</b></span>
<span>🪙 <b id="coins">0</b></span>
<span>💶 50€</span>
</div>
<div id="message">ANTONY DASH<br><small>SCAPPA DA FRANCESCO!</small></div>
<button id="start">GIOCA!</button>
<div id="controls">
<button id="left">⬅️</button>
<button id="jump">⬆️</button>
<button id="slide">⬇️</button>
<button id="right">➡️</button>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x87ceeb);
scene.fog=new THREE.Fog(0x87ceeb,25,90);
const camera=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,0.1,150);
camera.position.set(0,5,10);
camera.lookAt(0,1,0);
const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
document.getElementById("game").appendChild(renderer.domElement);
scene.add(new THREE.HemisphereLight(0xffffff,0x555555,2));
const sun=new THREE.DirectionalLight(0xffffff,2);
sun.position.set(-5,12,8);
scene.add(sun);
const material=color=>new THREE.MeshStandardMaterial({color});
const floor=new THREE.Mesh(new THREE.BoxGeometry(12,0.3,120),material(0x444444));
floor.position.set(0,-0.2,-35);
scene.add(floor);
for(const x of [-2,2]){
const line=new THREE.Mesh(new THREE.BoxGeometry(0.08,0.03,120),material(0xffffff));
line.position.set(x,0,-35);
scene.add(line);
}
// PIZZAIOLO
function createPerson(){
 const p=new THREE.Group();
 const skin=material(0xffc18c);
 const shirt=material(0xffffff);
 const pants=material(0x222222);

 const body=new THREE.Mesh(new THREE.BoxGeometry(0.75,0.9,0.45),shirt);
 body.position.y=1.15;
 p.add(body);

 const head=new THREE.Mesh(new THREE.SphereGeometry(0.38,20,20),skin);
 head.position.y=1.85;
 p.add(head);

 const hat=new THREE.Mesh(new THREE.CylinderGeometry(0.38,0.32,0.35,16),shirt);
 hat.position.y=2.25;
 p.add(hat);

 const brim=new THREE.Mesh(new THREE.CylinderGeometry(0.48,0.48,0.08,16),shirt);
 brim.position.y=2.08;
 p.add(brim);

 const legs=[];
 for(const x of [-0.22,0.22]){
  const leg=new THREE.Mesh(new THREE.BoxGeometry(0.25,0.75,0.3),pants);
  leg.position.set(x,0.38,0);
  p.add(leg);
  legs.push(leg);
 }
 p.userData.legs=legs;
 return p;
}

// FRANCESCO IL LAVAPIATTI
function createFrancesco(){
 const f=new THREE.Group();
 const skin=material(0xd99b70);
 const uniform=material(0x26354c);
 const apron=material(0xffffff);
 const dark=material(0x111111);
 const wood=material(0x9c5a20);
 const metal=material(0xaaaaaa);

 const body=new THREE.Mesh(new THREE.BoxGeometry(0.9,1.1,0.5),uniform);
 body.position.y=1.15;
 f.add(body);

 const face=new THREE.Mesh(new THREE.SphereGeometry(0.4,20,20),skin);
 face.position.y=1.95;
 f.add(face);

 const hair=new THREE.Mesh(new THREE.SphereGeometry(0.41,16,12),dark);
 hair.scale.y=0.45;
 hair.position.y=2.23;
 f.add(hair);

 const apronMesh=new THREE.Mesh(new THREE.BoxGeometry(0.7,0.8,0.08),apron);
 apronMesh.position.set(0,1.1,0.29);
 f.add(apronMesh);

 const handle=new THREE.Mesh(new THREE.CylinderGeometry(0.055,0.055,1.5,10),wood);
 handle.rotation.z=-0.5;
 handle.position.set(0.65,1.25,0);
 f.add(handle);

 const blade=new THREE.Mesh(new THREE.BoxGeometry(0.7,0.08,0.55),metal);
 blade.position.set(1.02,1.9,0);
 f.add(blade);
 return f;
}

const player=createPerson();
player.position.set(0,0,3);
scene.add(player);

const francesco=createFrancesco();
francesco.position.set(0,0,8);
scene.add(francesco);

// EDIFICI DELLA PIZZERIA
for(const side of [-1,1]){
 for(let i=0;i<9;i++){
  const building=new THREE.Mesh(
   new THREE.BoxGeometry(3,5,5),
   material(i%2?0xffd27d:0xf2a65a)
  );
  building.position.set(side*7,2.5,-i*10);
  scene.add(building);

  const windowMesh=new THREE.Mesh(
   new THREE.BoxGeometry(0.08,1.2,1),
   material(0x4b9ac0)
  );
  windowMesh.position.set(side*5.45,3,-i*10);
  scene.add(windowMesh);
 }
}

// INSEGNA
const sign=new THREE.Mesh(
 new THREE.BoxGeometry(5,1.2,0.3),
 material(0xb71c1c)
);
sign.position.set(0,5,-15);
scene.add(sign);

// STATO DEL GIOCO
let running=false;
let score=0;
let coins=0;
let speed=0.25;
let lane=0;
let jumpY=0;
let jumpVelocity=0;
let sliding=false;
let slideTime=0;
let objects=[];
let spawnTimer=0;
let chase=0;

const scoreEl=document.getElementById("score");
const coinsEl=document.getElementById("coins");
const message=document.getElementById("message");
const startButton=document.getElementById("start");

// GENERAZIONE OSTACOLI E MONETE
function spawnObject(){
 const roll=Math.random();
 let type=roll<0.45?"coin":roll<0.68?"box":roll<0.84?"barrier":"pizza";
 const group=new THREE.Group();

 if(type==="coin"){
  const coin=new THREE.Mesh(
   new THREE.TorusGeometry(0.35,0.12,12,24),
   material(0xffd700)
  );
  group.add(coin);
  group.position.y=1.1;
 }else if(type==="box"){
  const box=new THREE.Mesh(new THREE.BoxGeometry(1.1,1.1,0.9),material(0x8b4513));
  box.position.y=0.55;
  group.add(box);
 }else if(type==="barrier"){
  const bar=new THREE.Mesh(new THREE.BoxGeometry(1.3,0.45,0.6),material(0xe53935));
  bar.position.y=0.23;
  group.add(bar);
 }else{
  const pizza=new THREE.Mesh(new THREE.CylinderGeometry(0.55,0.55,0.18,24),material(0xffc107));
  pizza.position.y=0.6;
  group.add(pizza);
 }

 const lanes=[-2,0,2];
 const chosen=lanes[Math.floor(Math.random()*3)];
 group.position.x=chosen;
 group.position.z=-45;
 group.userData.type=type;
 scene.add(group);
 objects.push(group);
}

// MOVIMENTI
function moveLane(direction){
 if(!running)return;
 lane=Math.max(-1,Math.min(1,lane+direction));
}

function jump(){
 if(!running||jumpY>0)return;
 jumpVelocity=0.22;
}

function slide(){
 if(!running||sliding)return;
 sliding=true;
 slideTime=35;
}

document.getElementById("left").onclick=()=>moveLane(-1);
document.getElementById("right").onclick=()=>moveLane(1);
document.getElementById("jump").onclick=jump;
document.getElementById("slide").onclick=slide;

document.addEventListener("keydown",e=>{
 if(e.key==="ArrowLeft")moveLane(-1);
 if(e.key==="ArrowRight")moveLane(1);
 if(e.key==="ArrowUp"||e.key===" ")jump();
 if(e.key==="ArrowDown")slide();
});

let touchX=0,touchY=0;
renderer.domElement.addEventListener("touchstart",e=>{
 touchX=e.changedTouches[0].clientX;
 touchY=e.changedTouches[0].clientY;
},{passive:true});

renderer.domElement.addEventListener("touchend",e=>{
 const dx=e.changedTouches[0].clientX-touchX;
 const dy=e.changedTouches[0].clientY-touchY;
 if(Math.abs(dx)>35)moveLane(dx>0?1:-1);
 else if(Math.abs(dy)>35){
  if(dy<0)jump();
  else slide();
 }
},{passive:true});

function gameOver(){
 running=false;
 message.innerHTML="FRANCESCO TI HA PRESO!<br><small>DAMMI I MIEI 50 EURO! 😂</small>";
 message.style.display="block";
 startButton.textContent="RIGIOCA";
 startButton.style.display="block";
}
// MOTORE DEL GIOCO
let lastTime=0;

function animate(time){
 requestAnimationFrame(animate);

 const delta=lastTime?Math.min((time-lastTime)/16.67,2):1;
 lastTime=time;

 if(running){
  speed=Math.min(speed+0.00015*delta,0.65);

  // MOVIMENTO PIZZAIOLO
  player.position.x+=(lane*2-player.position.x)*0.2*delta;

  if(jumpY>0||jumpVelocity>0){
   jumpY+=jumpVelocity*delta;
   jumpVelocity-=0.012*delta;
   if(jumpY<0){
    jumpY=0;
    jumpVelocity=0;
   }
  }

  player.position.y=jumpY;

  // SCIVOLATA
  if(sliding){
   slideTime-=delta;
   player.scale.y=0.55;
   if(slideTime<=0){
    sliding=false;
    player.scale.y=1;
   }
  }

  // CORSA
  player.userData.legs.forEach((leg,i)=>{
   leg.rotation.x=Math.sin(time*0.015+i*Math.PI)*0.6;
  });

  // FRANCESCO INSEGUE
  chase+=0.0015*delta;
  francesco.position.z=8-chase*4;
  francesco.position.x+=(player.position.x-francesco.position.x)*0.025*delta;
  francesco.rotation.y=Math.sin(time*0.004)*0.12;

  if(francesco.position.z<4.3)gameOver();

  // GENERAZIONE OGGETTI
  spawnTimer+=delta;
  if(spawnTimer>55){
   spawnObject();
   spawnTimer=0;
  }

  // MOVIMENTO OGGETTI E COLLISIONI
  for(let i=objects.length-1;i>=0;i--){
   const obj=objects[i];
   obj.position.z+=speed*delta*2.5;
   obj.rotation.y+=0.025*delta;

   const sameLane=Math.abs(obj.position.x-player.position.x)<0.85;
   const nearPlayer=Math.abs(obj.position.z-player.position.z)<0.9;

   if(sameLane&&nearPlayer){
    if(obj.userData.type==="coin"){
     coins++;
     coinsEl.textContent=coins;
     scene.remove(obj);
     objects.splice(i,1);
     continue;
    }

    if(obj.userData.type==="box"&&jumpY>0.7){}
    else if(obj.userData.type==="barrier"&&sliding){}
    else if(obj.userData.type==="pizza"&&jumpY>0.8){}
    else gameOver();
   }

   if(obj.position.z>10){
    scene.remove(obj);
    objects.splice(i,1);
   }
  }

  score+=delta;
  scoreEl.textContent=Math.floor(score);
  camera.position.x+=(player.position.x*0.3-camera.position.x)*0.04;
 }

 renderer.render(scene,camera);
}

// AVVIO E RIAVVIO
function startGame(){
 objects.forEach(obj=>scene.remove(obj));
 objects=[];

 score=0;
 coins=0;
 speed=0.25;
 lane=0;
 jumpY=0;
 jumpVelocity=0;
 sliding=false;
 slideTime=0;
 chase=0;
 spawnTimer=0;

 player.position.set(0,0,3);
 player.scale.set(1,1,1);
 francesco.position.set(0,0,8);

 scoreEl.textContent="0";
 coinsEl.textContent="0";
 message.style.display="none";
 startButton.style.display="none";

 running=true;
}

startButton.addEventListener("click",startGame);

window.addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

requestAnimationFrame(animate);
</script>
</body>
</html>
